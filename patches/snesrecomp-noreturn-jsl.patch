+fn truncated_call_sites(graph: &FunctionDecodeGraph) -> Vec<(u32, u32)> {
+    graph
+        .insns()
+        .iter()
+        .filter_map(|decoded| {
+            let ins = &decoded.insn;
+            if !matches!(ins.mnem, "JSR" | "JSL")
+                || ins.terminal_jsr
+                || !decoded.successors.is_empty()
+            {
+                return None;
+            }
+            let target = if ins.mnem == "JSR" {
+                (ins.addr & 0xFF0000) | (ins.operand & 0xFFFF)
+            } else {
+                ins.operand & 0xFFFFFF
+            };
+            Some((ins.addr & 0xFFFFFF, target & 0xFFFFFF))
+        })
+        .collect()
