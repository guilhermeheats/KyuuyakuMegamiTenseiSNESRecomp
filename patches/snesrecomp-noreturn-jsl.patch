+RecompReturn cpu_dispatch_tail_pc(CpuState *cpu, uint32 pc24,
+                                  uint32 source_pc24, uint16 entry_s,
+                                  uint8 hrv) {
+    pc24 &= 0xFFFFFFu;
+    source_pc24 &= 0xFFFFFFu;
+    unsigned mx_idx = (unsigned)(((cpu->m_flag & 1) << 1) | (cpu->x_flag & 1));
+    int via_mirror = 0;
+    RecompReturn (*fp)(CpuState *) = _cpu_dispatch_lookup(cpu, pc24);
+    if (fp == NULL) {
+        if (dispatch_has_rom_mirror(pc24)) {
+            fp = _cpu_dispatch_lookup(cpu, pc24 ^ 0x800000u);
+            if (fp != NULL) via_mirror = 1;
+        }
+    }
+    _dispatch_log_record(pc24, source_pc24, mx_idx, fp != NULL, via_mirror);
+    if (fp != NULL) {
+        /* Tail entry: the target's prologue adopts the enclosing host
+         * return context (entry S + hrv) instead of pushing a new frame. */
+        cpu_tailcall_inherit_return_context(entry_s, hrv);
+        cpu->PB = (uint8)(pc24 >> 16);
+        return fp(cpu);
+    }
+    /* No AOT body for the live (m,x): run the real bytes with the same
+     * tail context. This is the same fallback as the unresolved indirect
+     * path, but reached through the live pointer dispatch. */
+    return interp_tier_dispatch_tail_ex(cpu, pc24, source_pc24, entry_s, hrv,
+                                        true);
