+    rom = make_lorom_bank0({
+        0x8000: bytes([0x22, 0x00, 0x81, 0x00, 0xEA]),  # JSL $008100; NOP
+        0x8100: bytes([0x6B]),                          # RTL
+    })
+    graph = decode_function(
+        rom, bank=0, start=0x8000, entry_m=0, entry_x=0,
